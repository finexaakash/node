    <form method="POST" action="/urls">
    <label>enter your url to genrate</label>
    <input type="text" name="url" placeholder="https://name.com"/>
    <button type="submit">genrate</button>
</form>
<% if (locals.id) { %>
    <h2>Generated URL:</h2>
    <a href="/<%= id %>">
        http://localhost:8000/<%= id %>
    </a>
<% } %>
<% if (locals.urls) { %>
    <table>
        <thead>
            <th>sr</th>
            <th>shorid</th>
            <th>uurl</th>
            <th>visit</th>
        </thead>
        <tdata>
            <% urls.forEach((url,index) => { %>
                <tr>
             <td><%= index+1 %></td>
             <td><%= url.shorturl %></td>
             <td><%= url.redirector %></td>
             <td><%= url.visit.length %></td>
             </tr>
            <% }) %>
            
        </tdata>
    </table>
<% } %>
</body>
</html>
